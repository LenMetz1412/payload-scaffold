{
  "name": "payload-scaffold",
  "version": "1.1.2",
  "description": "Next.js + Payload CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payloadcms:media:sync": ". ./.env.local && rsync -adv ${PROD_SSH_USER}@${PAYLOAD_PRODUCTION_URL}:${PROD_MEDIA_VOLUME_PATH} ${SYNC_LOCAL_MEDIA_DIR}/",
    "payloadcms:db:backup": ". ./.env.local && ssh ${PROD_SSH_USER}@${PAYLOAD_PRODUCTION_URL} docker exec ${PROD_DOCKER_DB_CONTAINER} mongodump -d ${PROD_DATABASE_NAME} --archive > ./db.backups/mongodb/${PROD_DATABASE_NAME}.$(date '+%Y-%m-%d-%H%M%S').archive",
    "payloadcms:db:restore": ". ./.env.local && docker exec -i ${DOCKER_DB_LOCAL_CONTAINER} mongorestore --nsFrom=${PROD_DATABASE_NAME}.* --nsTo=${PAYLOAD_DATABASE_URI##*/}.* --drop --archive --nsExclude=${PROD_DATABASE_NAME}.users < $(ls -td -- db.backups/mongodb/* | head -n 1)",
    "payloadcms:db:sync": "pnpm payloadcms:db:backup && pnpm payloadcms:db:restore"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@formatjs/intl-localematcher": "^0.6.2",
    "@payloadcms/admin-bar": "3.77.0",
    "@payloadcms/db-mongodb": "3.77.0",
    "@payloadcms/live-preview-react": "3.77.0",
    "@payloadcms/next": "3.77.0",
    "@payloadcms/payload-cloud": "3.77.0",
    "@payloadcms/plugin-form-builder": "3.77.0",
    "@payloadcms/plugin-nested-docs": "3.77.0",
    "@payloadcms/plugin-redirects": "3.77.0",
    "@payloadcms/plugin-search": "3.77.0",
    "@payloadcms/plugin-seo": "3.77.0",
    "@payloadcms/richtext-lexical": "3.77.0",
    "@payloadcms/ui": "3.77.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@types/jsonwebtoken": "^9.0.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.12.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "motion": "^12.23.24",
    "negotiator": "^1.0.0",
    "next": "15.4.11",
    "nodemailer": "^6.10.0",
    "payload": "3.77.0",
    "prism-react-renderer": "^2.4.1",
    "qs": "^6.14.0",
    "react": "19.2.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "19.2.1",
    "react-hook-form": "7.54.2",
    "react-markdown": "^9.0.3",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "sharp": "0.34.5",
    "slugify": "^1.6.6",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
"@payloadcms/email-nodemailer": "3.77.0",
    "@payloadcms/translations": "3.77.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/escape-html": "^1.0.4",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^6.4.21",
    "@types/qs": "^6.14.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "copyfiles": "^2.4.1",
"postcss": "^8.5.6",
    "tailwindcss": "^4.0.0",
    "typescript": "5.7.3",
    "uuid": "^11.1.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
