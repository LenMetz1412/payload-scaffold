# Database
PAYLOAD_DATABASE_URI=mongodb://localhost:27017/payload

# Payload
PAYLOAD_SECRET=change-me-to-a-random-secret
PAYLOAD_PUBLIC_ASSETS_PATH=system

# Mailer
PAYLOAD_MAILER_FROM=no-reply@example.com
PAYLOAD_MAILER_NAME=My App
NODE_MAILER_SMTP_HOST=smtp.example.com
NODE_MAILER_SMTP_PORT=587
NODE_MAILER_SMTP_USER=user@example.com
NODE_MAILER_SMTP_PWD=changeme
NODE_MAILER_SMTP_SECURE=false

# Google Places API (for GoogleReviewsBlock)
# Enable "Places API (New)" at console.cloud.google.com
GOOGLE_PLACES_API_KEY=

# Instagram Graph API (for SocialFeedBlock)
# Paste your initial long-lived token into AppSettings > Instagram in the CMS admin.
# The cron job at /api/cron/refresh-instagram-token keeps it current automatically.
# INSTAGRAM_ACCESS_TOKEN is only used as a fallback in local dev (before DB is seeded).
INSTAGRAM_ACCESS_TOKEN=

# Cron secret — must match the Authorization: Bearer header sent by Vercel cron
CRON_SECRET=change-me-to-a-random-secret

# Public
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_META_NAME=My App
NEXT_PUBLIC_META_TITLE=My App
NEXT_PUBLIC_META_DESCRIPTION=My App Description
NEXT_PUBLIC_META_TYPE=website
